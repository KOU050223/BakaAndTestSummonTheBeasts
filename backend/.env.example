# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=baka_user
DB_PASSWORD=your_password_here

# Go ゲームサーバーとの共有シークレット
# game/.env の同名項目にも、必ず同じ値を設定してください。
# openssl rand -hex 64
JWT_SECRET_KEY=your_shared_jwt_secret_key_here
INTERNAL_API_SECRET=your_shared_internal_api_secret_here

# Gemini Vision API (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
