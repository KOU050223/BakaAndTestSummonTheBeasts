# PostgreSQL (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=baka_user
DB_PASSWORD=your_password_here

# フロントエンドのオリジン（CORS 許可対象）
FRONTEND_URL=http://localhost:3000

# デモデータの初回投入時に使うパスワード
DEMO_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_USER_PASSWORD=replace-with-a-demo-user-password

# Web Push (VAPID)
# 生成: nix develop --command bash -c "cd backend && bundle exec ruby -e \"require 'web-push'; vpk = WebPush.generate_key; puts 'VAPID_PUBLIC_KEY=' + vpk.public_key; puts 'VAPID_PRIVATE_KEY=' + vpk.private_key\""
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CONTACT_EMAIL=admin@example.com
