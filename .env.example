# PostgreSQL (docker-compose)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=baka_user
DB_PASSWORD=your_password_here

# JWT署名専用のシークレットキー（`bin/rails secret` で生成）
# 未設定の場合は SECRET_KEY_BASE にフォールバックする
JWT_SECRET_KEY=your_jwt_secret_key_here

# フロントエンド（Next.js）の環境変数
# バックエンド API の URL（必須）
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
